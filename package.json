{
  "name": "atelier-mvp",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "build:render": "pnpm --filter web build && pnpm --filter api build && node tools/precompress.mjs apps/web/dist",
    "cloud:copy": "pnpm --filter api cloud:copy",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "media:upload": "pnpm --filter api media:upload"
  }
}
