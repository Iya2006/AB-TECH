# --- Base de données (Docker) ---
POSTGRES_USER=atelier
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=atelier
DB_PORT=5432
# Utilisé par l'API en développement local (pnpm dev)
DATABASE_URL=postgres://atelier:change-moi@localhost:5432/atelier

# --- API ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Administrateur initial : créé au premier démarrage s'il n'existe aucun administrateur.
# Ce mot de passe est TEMPORAIRE : l'administrateur doit le changer à sa première connexion,
# et tant qu'il ouvre encore un compte administrateur, le changement est redemandé.
ADMIN_EMAIL=contact@example.com
ADMIN_PASSWORD=change-moi-10-caracteres-min
# Clé de signature des sessions et des liens (32+ caractères aléatoires)
SESSION_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-32-caracteres

# --- Connexion avec Google (facultatif) ---
# console.cloud.google.com → API et services → Identifiants → « ID client OAuth » (Application Web)
# URI de redirection autorisée : <adresse du site>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mails « mot de passe oublié » (facultatif) ---
# ex. smtps://contact%40exemple.com:mot-de-passe-application@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=
# Adresse publique du site (liens des e-mails, retour de Google). Par défaut : la première origine de CORS_ORIGIN.
PUBLIC_URL=

# --- Cloudinary (optionnel : sans lui, les fichiers sont stockés sur le serveur) ---
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
VITE_CLOUDINARY_CLOUD_NAME=

# --- Production (docker compose up -d --build) ---
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
